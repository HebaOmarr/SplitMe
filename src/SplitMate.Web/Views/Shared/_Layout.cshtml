<!DOCTYPE html>
<html lang="@(Ui.Ar ? "ar" : "en")" dir="@(Ui.Ar ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f3f4f8" />
    <title>@ViewData["Title"] - SplitMate</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    @if (Ui.Ar)
    {
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap" />
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@(Ui.Ar ? "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" : "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    string Active(string c) => c == controller ? "active" : "";
}
<body class="@(signedIn ? "has-nav" : "")">
    @if (signedIn)
    {
        <header class="app-header">
            <div class="app-container d-flex align-items-center justify-content-between">
                <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-logo"><i class="bi bi-wallet2"></i></span><span class="brand-text">SplitMate</span></a>
                <div class="dropdown">
                    <button class="btn p-0 border-0" type="button" data-bs-toggle="dropdown" aria-label="@Ui.T("Account")">@Ui.Avatar((string?)ViewBag.MeName ?? User.Identity!.Name, "sm")</button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4">
                        <li><span class="dropdown-item-text small text-muted">@Ui.T("Signed in as") <strong>@User.Identity?.Name</strong></span></li>
                        <li><a class="dropdown-item" asp-controller="Group" asp-action="Index"><i class="bi bi-people me-2"></i>@Ui.T("My group")</a></li>
                        <li><a class="dropdown-item" asp-controller="Contributions" asp-action="Index"><i class="bi bi-piggy-bank me-2"></i>@Ui.T("Flat payments")</a></li>
                        <li><a class="dropdown-item" asp-controller="Help" asp-action="Index"><i class="bi bi-question-circle me-2"></i>@Ui.T("Help")</a></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Language" asp-route-lang="@(Ui.Ar ? "en" : "ar")" asp-route-returnUrl="@returnUrl"><i class="bi bi-translate me-2"></i>@(Ui.Ar ? "English" : "عربي")</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>@Ui.T("Logout")</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
    }

    <main class="app-container py-2">
        @if (!signedIn)
        {
            <div class="text-end"><a class="small fw-semibold text-decoration-none" asp-controller="Account" asp-action="Language" asp-route-lang="@(Ui.Ar ? "en" : "ar")" asp-route-returnUrl="@returnUrl"><i class="bi bi-translate me-1"></i>@(Ui.Ar ? "English" : "عربي")</a></div>
        }
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success d-flex align-items-center gap-2 py-2"><i class="bi bi-check-circle-fill"></i>@message</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 py-2"><i class="bi bi-exclamation-circle-fill"></i>@error</div>
        }
        @RenderBody()
    </main>

    @if (signedIn)
    {
        <nav class="bottom-nav">
            <a class="@Active("Home")" style="--c:#6366f1" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door-fill"></i>@Ui.T("Home")</a>
            <a class="@Active("Timeline")" style="--c:#f97316" asp-controller="Timeline" asp-action="Index"><i class="bi bi-clock-history"></i>@Ui.T("Timeline")</a>
            <a class="fab" asp-controller="Transactions" asp-action="Create" aria-label="@Ui.T("Add expense")"><i class="bi bi-plus-lg"></i></a>
            <a class="@Active("Stats")" style="--c:#10b981" asp-controller="Stats" asp-action="Index"><i class="bi bi-bar-chart-fill"></i>@Ui.T("Dashboard")</a>
            <a class="@Active("Group")" style="--c:#ec4899" asp-controller="Group" asp-action="Index"><i class="bi bi-people-fill"></i>@Ui.T("Group")</a>
        </nav>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
