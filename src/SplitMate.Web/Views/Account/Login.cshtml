@model LoginVm
@{
    ViewData["Title"] = Ui.T("Login");
}

<div class="auth-wrap">
    <div class="text-center mb-4">
        <span class="brand-logo auth-logo mb-3"><i class="bi bi-wallet2"></i></span>
        <h1 class="h2 fw-bold mb-1 brand-text">SplitMate</h1>
        <p class="text-muted">@Ui.T("Who pays whom, without the awkward math.")</p>
    </div>

    <div class="card-soft card-pad">
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="UserName" class="form-label">@Ui.T("Username")</label>
                <input asp-for="UserName" class="form-control" autocomplete="username" autocapitalize="none" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">@Ui.T("Password")</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-lg">@Ui.T("Login")</button>
        </form>
    </div>
    <p class="mt-3 text-center text-muted"><span>@Ui.T("No account?")</span> <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold">@Ui.T("Create one")</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
