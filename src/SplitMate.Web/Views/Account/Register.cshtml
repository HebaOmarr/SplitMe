@model RegisterVm
@{
    ViewData["Title"] = Ui.T("Register");
}

<div class="auth-wrap">
    <div class="text-center mb-4">
        <span class="brand-logo auth-logo mb-3"><i class="bi bi-wallet2"></i></span>
        <h1 class="h3 fw-bold mb-1 brand-text">@Ui.T("Create your account")</h1>
        <p class="text-muted">@Ui.T("It takes 10 seconds.")</p>
    </div>

    <div class="card-soft card-pad">
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label">@Ui.T("Display name")</label>
                <input asp-for="DisplayName" class="form-control" placeholder="@Ui.T("What friends call you")" />
                <span asp-validation-for="DisplayName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="UserName" class="form-label">@Ui.T("Username")</label>
                <input asp-for="UserName" class="form-control" autocomplete="username" autocapitalize="none" placeholder="@Ui.T("Used to log in")" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label asp-for="Password" class="form-label">@Ui.T("Password")</label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label asp-for="ConfirmPassword" class="form-label">@Ui.T("Confirm")</label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-lg">@Ui.T("Create account")</button>
        </form>
    </div>
    <p class="mt-3 text-center text-muted"><span>@Ui.T("Have an account?")</span> <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold">@Ui.T("Login")</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
