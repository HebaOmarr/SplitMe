@model Group
@{
    ViewData["Title"] = Model.Name;
    var joinLink = Url.Action("Setup", "Group", new { code = Model.JoinCode }, Context.Request.Scheme);
}

<h1 class="h4 fw-bold mb-3">@Model.Name</h1>

<div class="hero hero-cyan mb-4 text-center">
    <div class="hero-label">@Ui.T("Invite friends with this code")</div>
    <div class="join-code my-2">@Model.JoinCode</div>
    <div class="d-flex justify-content-center gap-2">
        <button type="button" class="btn btn-light btn-sm rounded-pill px-3" data-copy="@Model.JoinCode"><i class="bi bi-clipboard me-1"></i>@Ui.T("Copy code")</button>
        <button type="button" class="btn btn-light btn-sm rounded-pill px-3" data-share="@joinLink" data-copy="@joinLink"><i class="bi bi-share me-1"></i>@Ui.T("Share link")</button>
    </div>
    @if (ViewBag.IsOwner == true)
    {
        <form asp-action="RegenerateCode" method="post" class="mt-3" onsubmit="return confirm('@Ui.T("Create a new code? The old one will stop working.")');">
            <button type="submit" class="btn btn-link btn-sm text-white text-opacity-75">@Ui.T("Make a new code")</button>
        </form>
    }
</div>

<div class="section-title"><span class="dot violet"></span>@Ui.T("Members · {0}", Model.Members.Count)</div>
<div class="card-soft accent-violet">
    @foreach (var m in Model.Members.OrderBy(m => m.DisplayName))
    {
        <div class="row-item">
            @Ui.Avatar(m.DisplayName)
            <div class="flex-grow-1 min-w-0">
                <div class="fw-semibold text-truncate">@m.DisplayName</div>
                <small class="text-muted">@@@m.UserName</small>
            </div>
            @if (m.Id == Model.OwnerId)
            {
                <span class="chip tone-transport"><i class="bi bi-star-fill me-1"></i>@Ui.T("Owner")</span>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        const t = @Json.Serialize(new { join = Ui.T("Join my SplitMate group"), copied = Ui.T("Copied") });
        document.querySelectorAll('[data-copy]').forEach(b => b.addEventListener('click', async () => {
            if (b.dataset.share && navigator.share) {
                try { await navigator.share({ title: t.join, url: b.dataset.share }); } catch { }
                return;
            }
            await navigator.clipboard.writeText(b.dataset.copy);
            const text = b.innerHTML;
            b.innerHTML = '<i class="bi bi-check2 me-1"></i>' + t.copied;
            setTimeout(() => b.innerHTML = text, 1500);
        }));
    </script>
}
