@model StatsVm
@{
    ViewData["Title"] = Ui.T("Housing expenses");
    var colors = new Dictionary<string, string>
    {
        ["Food"] = "#f97316",
        ["Rent"] = "#8b5cf6",
        ["Bills"] = "#0891b2",
        ["Shopping"] = "#ec4899",
        ["Transport"] = "#d97706",
        ["Other"] = "#6366f1"
    };
}

<div class="d-flex justify-content-between align-items-center gap-2 mb-2">
    <h1 class="h4 fw-bold mb-0">@Ui.T("Housing expenses")</h1>
    <form method="get">
        <input type="month" name="month" value="@Model.Month.ToString("yyyy-MM")" class="form-control form-control-sm" onchange="this.form.submit()" aria-label="@Ui.T("Month")" />
    </form>
</div>

<div class="hero mb-4">
    <div class="hero-label">@Ui.T("Group spending in {0}", Ui.Date(Model.Month, "MMMM yyyy"))</div>
    <div class="hero-amount amount">@Ui.Money(Model.Total)</div>
    <div class="hero-stats">
        <div>
            <span class="stat-icon neg"><i class="bi bi-receipt"></i></span>
            <span><small>@Ui.T("Total expenses")</small><strong class="amount">@Ui.Money(Model.TotalExpenses)</strong></span>
        </div>
        <div>
            <span class="stat-icon neg"><i class="bi bi-hourglass-split"></i></span>
            <span><small>@Ui.T("Still owed")</small><strong class="amount">@Ui.Money(Model.StillOwed)</strong></span>
        </div>
    </div>
</div>

<div class="section-title"><span class="dot violet"></span>@Ui.T("Each person")</div>
<div class="card-soft mb-3">
    @foreach (var p in Model.People)
    {
        <details class="person">
            <summary class="row-item">
                @Ui.Avatar(p.Name)
                <div class="flex-grow-1 min-w-0">
                    <div class="fw-semibold text-truncate">@p.Name</div>
                    <small class="text-muted">@Ui.T("Paid in {0}", Ui.Date(Model.Month, "MMMM"))</small>
                </div>
                <span class="amount fw-bold">@Ui.Money(p.Paid)</span>
                <i class="bi bi-chevron-down text-muted person-chevron"></i>
            </summary>
            <div class="px-3 pb-3 small">
                @if (p.Paid > 0)
                {
                    <div class="fw-semibold mb-1">@Ui.T("Where the money went")</div>
                    <partial name="_Meters" model="p.Reasons" />
                    <div class="fw-semibold mt-3 mb-1">@Ui.T("For whom")</div>
                    <partial name="_Meters" model="p.ForWhom" />
                }
                else
                {
                    <div class="text-muted">@Ui.T("Nothing paid in {0}", Ui.Date(Model.Month, "MMMM"))</div>
                }
                <div class="fw-semibold mt-3 mb-1">@Ui.T("Last 6 months")</div>
                <partial name="_Meters" model="p.Months" />
            </div>
        </details>
    }
</div>

@if (Model.Items.Count > 0)
{
    <div class="section-title"><span class="dot violet"></span>@Ui.T("Expenses")</div>
    <div class="card-soft mb-3">
        @foreach (var t in Model.Items)
        {
            <partial name="_TransactionLine" model="t" />
        }
    </div>
}

<div class="section-title"><span class="dot violet"></span>@Ui.T("By category")</div>
<div class="card-soft card-pad mb-3">
    @if (Model.Categories.Count == 0)
    {
        <div class="empty">@Ui.T("No expenses this month")</div>
    }
    else
    {
        <div style="position:relative;height:220px"><canvas id="byCategory" role="img" aria-label="@Ui.T("By category")"></canvas></div>
        <div class="mt-3 small">
            @foreach (var c in Model.Categories)
            {
                <div class="d-flex align-items-center gap-2 py-1">
                    <span style="width:10px;height:10px;border-radius:3px;background:@colors[c.Name]"></span>
                    <span class="flex-grow-1">@Ui.T(c.Name)</span>
                    <span class="text-muted">@Math.Round(c.Amount * 100 / Model.Total)%</span>
                    <span class="amount fw-semibold">@Ui.Money(c.Amount)</span>
                </div>
            }
        </div>
    }
</div>

<div class="section-title"><span class="dot violet"></span>@Ui.T("Last 6 months")</div>
<div class="card-soft card-pad mb-3">
    <div style="position:relative;height:220px"><canvas id="byMonth" role="img" aria-label="@Ui.T("Last 6 months")"></canvas></div>
    <details class="mt-2 small">
        <summary class="text-muted">@Ui.T("Show as table")</summary>
        @foreach (var m in Model.Months)
        {
            <div class="d-flex justify-content-between py-1">
                <span>@m.Name</span>
                <span class="amount fw-semibold">@Ui.Money(m.Amount)</span>
            </div>
        }
    </details>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
    <script>
        const cats = @Json.Serialize(Model.Categories.Select(c => new { label = Ui.T(c.Name), value = c.Amount, color = colors[c.Name] }));
        const months = @Json.Serialize(Model.Months.Select(m => new { label = m.Name, value = m.Amount }));
        const rtl = document.dir === 'rtl';
        const money = v => v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
        Chart.defaults.color = '#6b7280';

        const byCategory = document.getElementById('byCategory');
        if (byCategory) new Chart(byCategory, {
            type: 'doughnut',
            data: { labels: cats.map(c => c.label), datasets: [{ data: cats.map(c => c.value), backgroundColor: cats.map(c => c.color), borderColor: '#fff', borderWidth: 2, borderRadius: 4 }] },
            options: { cutout: '65%', maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { rtl, callbacks: { label: c => ' ' + c.label + ': ' + money(c.parsed) } } } }
        });

        new Chart(document.getElementById('byMonth'), {
            type: 'bar',
            data: { labels: months.map(m => m.label), datasets: [{ data: months.map(m => m.value), backgroundColor: '#6366f1', borderRadius: 4, maxBarThickness: 36 }] },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { rtl, callbacks: { label: c => ' ' + money(c.parsed.y) } } },
                scales: {
                    x: { reverse: rtl, grid: { display: false } },
                    y: { position: rtl ? 'right' : 'left', beginAtZero: true, grid: { color: '#f0f1f5' }, border: { display: false } }
                }
            }
        });
    </script>
}
